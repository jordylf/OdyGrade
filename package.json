{
  "name": "odygrade",
  "version": "0.5.3",
  "private": true,
  "description": "Reference-based color grading for Adobe 2024",
  "scripts": {
    "test": "node --test tests/*.test.cjs",
    "dev": "node tools/serve.cjs",
